# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Retention Period (5 years in seconds: 5 * 365.25 * 24 * 3600 = 157,788,000)
RETENTION_PERIOD_SECONDS=157788000

# Redirect HTTP Status Code (302 Found)
REDIRECT_STATUS_CODE=302

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set Redis TTL (matches retention period or cache retention)
REDIS_CACHE_TTL_SECONDS=157788000

# PostgreSQL Persistent Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=urlshortener

# ID Generation Initial Offset (e.g. 10,000,000 ensures 6-7 char Base62 codes)
ID_OFFSET=1000000000
